# Do not treat the local backup adapter as disaster recovery by itself.
# Mount BACKUP_ROOT on separate encrypted storage or replace the adapter with an approved off-site connector.
BACKUP_ROOT=/secure-backup-volume/junior-lawyer
STRUCTURED_LOGGING_ENABLED=true
SYSTEM_HEALTH_CHECK_INTERVAL_MINUTES=15
SYSTEM_HEALTH_DEFAULT_RESTORE_VERIFICATION_DAYS=30
BACKGROUND_JOBS_ENABLED=true
BACKGROUND_WORKER_ORG_ID=<organization-uuid>

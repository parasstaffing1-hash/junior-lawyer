# Never commit the real .env.production file.
APP_DOMAIN=legal.example.com
TLS_EMAIL=ops@example.com
APP_VERSION=0.29.0-rc.1
BUILD_REF=release-0.29.0-rc.1
COMMIT_REF=<git-sha>

# Replace tags with organization-approved immutable digests before production.
POSTGRES_IMAGE=postgres:17-alpine
ALPINE_IMAGE=alpine:3
CADDY_IMAGE=caddy:2-alpine
MINIO_IMAGE=minio/minio:latest
MINIO_MC_IMAGE=minio/mc:latest

POSTGRES_PASSWORD=<random-long-secret>
MINIO_ROOT_USER=<random-access-key>
MINIO_ROOT_PASSWORD=<random-long-secret>
MINIO_APP_USER=<random-app-access-key>
MINIO_APP_PASSWORD=<random-app-secret-key>
MINIO_DOCUMENT_BUCKET=junior-lawyer-documents
STORAGE_S3_REGION=us-east-1

SECURITY_AUDIT_HMAC_KEY=<32+-byte-random-secret>
SECURITY_PRIVACY_HASH_KEY=<32+-byte-random-secret>
# Use only during the initial owner bootstrap, then remove/rotate it.
SECURITY_BOOTSTRAP_SECRET=<one-time-bootstrap-secret>

# Existing Batch-20 workers are organization scoped. Start additional worker sets per organization.
WORKER_ORGANIZATION_ID=<organization-uuid>

# Batch 25 integration credentials. Prefer Docker/Vault/cloud secret injection over committing values here.
JL_GOOGLE_CLIENT_SECRET=<secret-store-injected>
JL_GOOGLE_REFRESH_TOKEN=<secret-store-injected>
JL_RAZORPAY_KEY_SECRET=<secret-store-injected>
JL_RAZORPAY_WEBHOOK_SECRET=<secret-store-injected>
JL_DOCUSIGN_ACCESS_TOKEN=<secret-store-injected>
JL_DOCUSIGN_WEBHOOK_HMAC=<secret-store-injected>

# Batch 26 controlled legal-data manifest drop. Keep this directory operator-managed/read-only in app containers.
LEGAL_DATA_IMPORT_HOST_PATH=./legal-imports
LEGAL_DATA_MAX_MANIFEST_MB=50
LEGAL_DATA_STALE_SWEEP_MINUTES=60

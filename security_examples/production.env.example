APP_ENV=production
DEBUG=false
SECURITY_ENFORCE_AUTH=true
SECURITY_BOOTSTRAP_SECRET=replace-with-a-long-random-bootstrap-secret
SECURITY_COOKIE_SECURE=true
SECURITY_COOKIE_SAMESITE=lax
SECURITY_AUDIT_HMAC_KEY=replace-with-a-separate-random-hmac-secret
SECURITY_PRIVACY_HASH_KEY=replace-with-a-separate-random-privacy-hash-secret
FRONTEND_ORIGINS=https://law.example.com
# Use a production PostgreSQL URL, preferably from a secret manager.
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/junior_lawyer

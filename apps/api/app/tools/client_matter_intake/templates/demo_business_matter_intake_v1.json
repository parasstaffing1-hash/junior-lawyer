{
  "id": "demo_business_matter_intake_v1",
  "version": "1.0.0",
  "title": "Business Matter Intake (Demo)",
  "matter_type": "business_legal_matter",
  "client_type": "business",
  "jurisdiction": "Demo / jurisdiction-neutral",
  "effective_from": "2026-01-01",
  "effective_to": null,
  "sections": [
    {"key": "organization", "title": "Organization", "description": "Business-client and primary-contact details."},
    {"key": "matter", "title": "Matter", "description": "Matter classification and key commercial information."},
    {"key": "parties", "title": "Parties", "description": "Information used to prepare a conflicts search."}
  ],
  "fields": [
    {"key": "organization_name", "label": "Organization legal name", "section": "organization", "field_type": "text", "required": true, "max_length": 300, "include_in_conflict_terms": true},
    {"key": "trading_names", "label": "Trading / former names", "section": "organization", "field_type": "textarea", "required": false, "max_length": 1200},
    {"key": "contact_name", "label": "Primary contact", "section": "organization", "field_type": "text", "required": true, "max_length": 300, "include_in_conflict_terms": true},
    {"key": "contact_email", "label": "Primary contact email", "section": "organization", "field_type": "email", "required": true, "max_length": 320},
    {"key": "contact_phone", "label": "Primary contact phone", "section": "organization", "field_type": "phone", "required": true, "max_length": 30},
    {"key": "matter_type", "label": "Business matter type", "section": "matter", "field_type": "choice", "required": true, "allowed_values": ["Contract review", "Transaction", "Dispute", "Employment", "Compliance", "Corporate governance", "Other"]},
    {"key": "matter_summary", "label": "Matter summary", "section": "matter", "field_type": "textarea", "required": true, "max_length": 6000},
    {"key": "transaction_value", "label": "Transaction / claim value", "section": "matter", "field_type": "number", "required": false},
    {"key": "target_date", "label": "Target / key date", "section": "matter", "field_type": "date", "required": false},
    {"key": "counterparty_known", "label": "Is a counterparty or adverse party known?", "section": "parties", "field_type": "boolean", "required": true},
    {"key": "related_entities_known", "label": "Are related entities relevant to the matter?", "section": "parties", "field_type": "boolean", "required": true}
  ],
  "consents": [
    {"key": "authority_confirmation", "label": "Authority confirmation", "text": "The submitter confirms they are authorized to provide this information for preliminary intake review.", "required": true},
    {"key": "no_engagement_ack", "label": "No-engagement acknowledgement", "text": "Preliminary intake and conflicts review do not by themselves create an engagement.", "required": true}
  ],
  "conflict_requirements": [
    {"description": "A counterparty/adverse party was indicated, but no conflict-check party record was supplied.", "min_parties": 1, "applies_if_all": [{"field": "counterparty_known", "values": ["yes"]}]},
    {"description": "Related entities were indicated; add all known related entities as conflict-check party records before review.", "min_parties": 1, "applies_if_all": [{"field": "related_entities_known", "values": ["yes"]}]}
  ],
  "source_note": "Demo workflow only. Replace with a law-firm-approved business intake form, client-identification process, conflicts protocol, privacy notice, and engagement controls."
}

APP_NAME=Junior Lawyer API
APP_ENV=development
DEBUG=true
APP_VERSION=0.29.0-rc.1
BUILD_REF=
COMMIT_REF=
API_DOCS_ENABLED=true
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./junior_lawyer.db
FRONTEND_ORIGINS=http://localhost:3000
STORAGE_ROOT=./data/documents
STORAGE_BACKEND=local
# Batch 24: set STORAGE_BACKEND=s3 in production. Endpoint may be MinIO or another S3-compatible service.
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_SECURE=true
STORAGE_CACHE_ROOT=./data/storage-cache
MAX_UPLOAD_MB=75
PDF_NATIVE_TEXT_THRESHOLD=45
OCR_LANGUAGES=eng+hin
OCR_DPI=180
OCR_ENABLED=true

# AI is disabled by default. Local and remote providers use an OpenAI-compatible HTTP API.
AI_ENABLED=false
AI_LOCAL_ENABLED=false
AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_API_KEY=
AI_LOCAL_MODEL=local-legal-model
AI_REMOTE_ENABLED=false
AI_REMOTE_BASE_URL=
AI_REMOTE_API_KEY=
AI_REMOTE_MODEL=
AI_DEFAULT_MAX_SOURCES=12
AI_DEFAULT_MAX_INPUT_TOKENS=6000
AI_DEFAULT_MAX_OUTPUT_TOKENS=1200
AI_REQUEST_TIMEOUT_SECONDS=90

# Batch 10 · law-firm security. Keep false only for local/open development.
SECURITY_ENFORCE_AUTH=false
SECURITY_BOOTSTRAP_SECRET=
SECURITY_SESSION_COOKIE_NAME=jl_session
SECURITY_COOKIE_SECURE=false
SECURITY_COOKIE_SAMESITE=lax
SECURITY_SESSION_TOUCH_SECONDS=60
# scrypt work factors are configurable so production can tune them to its hardware.
SECURITY_SCRYPT_N=16384
SECURITY_SCRYPT_R=8
SECURITY_SCRYPT_P=5
SECURITY_SCRYPT_DKLEN=32
# Set strong independent secrets in production.
SECURITY_AUDIT_HMAC_KEY=
SECURITY_PRIVACY_HASH_KEY=
SECURITY_HSTS_SECONDS=31536000

# Batch 12 · client portal (separate external session)
PORTAL_SESSION_COOKIE_NAME=jl_client_session
PORTAL_SESSION_HOURS=12
PORTAL_INVITE_HOURS=168

# Batch 20 · durable database-backed jobs.
# Keep false for simple single-user local development. Production can enable this so uploads queue OCR/extraction.
BACKGROUND_JOBS_ENABLED=false
BACKGROUND_WORKER_POLL_SECONDS=1.0
BACKGROUND_WORKER_HEARTBEAT_SECONDS=20
# Each worker is scoped to one firm/organization UUID.
BACKGROUND_WORKER_ORG_ID=

# Batch 21 · observability, local backup foundation and scheduled maintenance.
BACKUP_ROOT=./data/backups
SYSTEM_HEALTH_HISTORY_LIMIT=90
SYSTEM_HEALTH_DEFAULT_RESTORE_VERIFICATION_DAYS=30
SYSTEM_HEALTH_CHECK_INTERVAL_MINUTES=15
STRUCTURED_LOGGING_ENABLED=true

# Batch 19: optional local-only multilingual sentence-transformers model path.
# Leave unset to use the built-in deterministic feature-hash vector.
# SEARCH_LOCAL_EMBEDDING_MODEL_PATH=/models/bge-m3

# Batch 25 · integration secret examples. Connection records should reference these as env://NAME.
# JL_GOOGLE_CLIENT_SECRET=
# JL_GOOGLE_REFRESH_TOKEN=
# JL_RAZORPAY_KEY_SECRET=
# JL_RAZORPAY_WEBHOOK_SECRET=
# JL_DOCUSIGN_ACCESS_TOKEN=
# JL_DOCUSIGN_WEBHOOK_HMAC=
# JL_GENERIC_WEBHOOK_OUTBOUND_SECRET=
# JL_GENERIC_WEBHOOK_INBOUND_SECRET=

# Batch 26 · legal-data operations (normalized manifests only; no protected scraping)
LEGAL_DATA_IMPORT_ROOT=./data/legal-imports
LEGAL_DATA_MAX_MANIFEST_MB=50
LEGAL_DATA_STALE_SWEEP_MINUTES=60
